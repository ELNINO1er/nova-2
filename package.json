{
  "name": "nova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "nodemon server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "start": "node server/index.js",
    "bootstrap:admin": "node server/scripts/bootstrap-admin.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0",
    "swagger-ui-express": "^5.0.1",
    "vite": "^7.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.8"
  }
}
