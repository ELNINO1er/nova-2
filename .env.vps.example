# Copier vers .env sur le VPS. Ne jamais versionner .env.
DOMAIN=nova.mhtechconsulting.com
PROXY_NETWORK=scmc-backend_default

MYSQL_DATABASE=nova
MYSQL_USER=nova
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_ROOT_PASSWORD

JWT_SECRET=CHANGE_ME_64_HEXADECIMAL_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_64_HEXADECIMAL_VALUE

# Choisir webhook ou twilio avant d'activer les connexions OTP.
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Alternative Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
